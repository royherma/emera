{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emera-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    "ENVIRONMENT": "dev",
    "INVITES_REQUIRED": "false",
    "SEED_INVITE_CODE": "welcome-dev",
    "PROOF_SECRET": "dev-only-proof-secret",
    "PUBLIC_ORIGIN": "",
    "FUNDING": "on",
    "FUND_ADMIN_KEY": "dev-fund-admin"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "emera-dev", "database_id": "local-dev", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "emera-media-dev" }],
  "images": { "binding": "IMAGES" },
  "durable_objects": { "bindings": [{ "name": "CHAT_LIVE", "class_name": "ChatLive" }] },
  "migrations": [{ "tag": "v1-chat-live", "new_sqlite_classes": ["ChatLive"] }],

  "env": {
    "staging": {
      "name": "emera-api-staging",
      "ratelimits": [
        { "name": "SIGNIN_LIMIT", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } },
        { "name": "WRITE_LIMIT", "namespace_id": "1102", "simple": { "limit": 120, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "SENTRY_DSN": "https://f1c13fe2a5084a5d09919d7c213ee80d@o4512099364503552.ingest.us.sentry.io/4512422700449792",
        "INVITES_REQUIRED": "false",
        "PUBLIC_ORIGIN": "",
        "FUNDING": "on",
        "STRIPE_ACCOUNT_ID": "acct_1TqRrs2cbiVEsA2f",
        "STRIPE_SPONSOR_PRODUCT": "prod_VcXslLcZqrRZk1",
        "FUND_PAGE_URL": "https://emera-site-staging.techguyver1337.workers.dev/fund/"
      },
      "triggers": { "crons": ["*/15 * * * *", "0 1 3 * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "emera-staging", "database_id": "2fa77b67-d18c-43e8-8839-6c7dc982998e", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "emera-media-staging" }],
      "images": { "binding": "IMAGES" },
      "durable_objects": { "bindings": [{ "name": "CHAT_LIVE", "class_name": "ChatLive" }] },
      "media": { "binding": "VIDEO" },
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [{ "binding": "VIDEO_JOBS", "queue": "emera-video-staging" }],
        "consumers": [{ "queue": "emera-video-staging", "max_batch_size": 1, "max_retries": 2 }]
      }
    },
    "production": {
      "name": "emera-api-production",
      "ratelimits": [
        { "name": "SIGNIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
        { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SENTRY_DSN": "https://f1c13fe2a5084a5d09919d7c213ee80d@o4512099364503552.ingest.us.sentry.io/4512422700449792",
        "INVITES_REQUIRED": "false",
        "PUBLIC_ORIGIN": "https://emera.social",
        "FUNDING": "off",
        "POSTS_PER_DAY": "10"
      },
      "triggers": { "crons": ["*/15 * * * *", "0 1 3 * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "emera-prod", "database_id": "e74c4221-f4e7-4304-a1a2-5eceab8f5503", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "emera-media-prod" }],
      "images": { "binding": "IMAGES" },
      "durable_objects": { "bindings": [{ "name": "CHAT_LIVE", "class_name": "ChatLive" }] },
      "media": { "binding": "VIDEO" },
      "ai": { "binding": "AI" },
      "queues": {
        "producers": [{ "binding": "VIDEO_JOBS", "queue": "emera-video-production" }],
        "consumers": [{ "queue": "emera-video-production", "max_batch_size": 1, "max_retries": 2 }]
      },
      "routes": [
        { "pattern": "api.emera.social", "custom_domain": true },
        { "pattern": "emera.social/@*", "zone_name": "emera.social" },
        { "pattern": "emera.social/p/*", "zone_name": "emera.social" },
        { "pattern": "emera.social/media/*", "zone_name": "emera.social" },
        { "pattern": "emera.social/embed/*", "zone_name": "emera.social" },
        { "pattern": "emera.social/oembed*", "zone_name": "emera.social" },
        { "pattern": "emera.social/feed.xml*", "zone_name": "emera.social" }
      ]
    }
  }
}
