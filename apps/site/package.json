{
  "name": "emera-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "og": "node scripts/og.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --local --port 5038",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "index": "node scripts/index.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
