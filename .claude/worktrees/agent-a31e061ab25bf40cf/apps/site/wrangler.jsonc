{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emera-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "emera-site-local", "database_id": "TBD", "migrations_dir": "migrations" }
  ],
  "env": {
    "staging": {
      "name": "emera-site-staging",
      "workers_dev": true,
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "emera-site-staging", "database_id": "55193bab-c903-4f35-b059-93df0b37c3b6", "migrations_dir": "migrations" }
      ]
    },
    "production": {
      "name": "emera-site",
      "workers_dev": false,
      "routes": [{ "pattern": "emera.social", "custom_domain": true }, { "pattern": "www.emera.social", "custom_domain": true }],
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "emera-site", "database_id": "daae3f49-ca5f-4d42-ac1e-4281701c86c1", "migrations_dir": "migrations" }
      ]
    }
  }
}
